{
  "name": "@chrok/braid",
  "version": "0.2.0",
  "license": "MIT",
  "description": "TypeScript runtime for LLM agent graphs with bounded loops, live updates, and isolated Git worktrees",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/openai": {
      "types": "./dist/adapters/openai.d.ts",
      "import": "./dist/adapters/openai.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "examples",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "ROADMAP.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "demo": "tsx examples/basic.ts",
    "check:pi": "npm run build && npm run check --workspace @chrok/pi-braid",
    "test:pi": "npm run build && npm test --workspace @chrok/pi-braid",
    "prepack": "npm run build",
    "build:pi": "npm run build --workspace @chrok/pi-braid",
    "test:package": "node scripts/package-smoke.mjs",
    "verify": "npm run check && npm test && npm run check:pi && npm run test:pi && npm run examples && npm run test:package",
    "examples": "tsx examples/basic.ts && tsx examples/code-review.ts && tsx examples/failure-handling.ts && tsx examples/custom-runner.ts && tsx examples/execution-control.ts",
    "bench": "npm run build && node --expose-gc scripts/benchmark.mjs",
    "demo:panel": "tsx scripts/panel-demo.ts",
    "test:pi:live": "npm run build:pi && node integrations/pi/test/live/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "@chrok/braid": "file:."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Epsirom/braid.git"
  },
  "homepage": "https://github.com/Epsirom/braid#readme",
  "bugs": {
    "url": "https://github.com/Epsirom/braid/issues"
  },
  "keywords": [
    "llm",
    "ai-agents",
    "agents",
    "agent-runtime",
    "agent-orchestration",
    "graph",
    "bounded-loops",
    "git-worktree",
    "orchestration",
    "openai-compatible",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "workspaces": [
    "integrations/pi"
  ]
}

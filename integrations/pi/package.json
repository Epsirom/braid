{
  "name": "@chrok/pi-braid",
  "version": "0.1.3",
  "license": "MIT",
  "description": "Pi extension for Braid: background DAG jobs and a live flow panel",
  "type": "module",
  "dependencies": {
    "grok-mermaid": "^0.2.2",
    "@chrok/braid": "0.1.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0",
    "@types/node": "^22.0.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "node ../../scripts/build.mjs pi",
    "prepack": "npm run build"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Epsirom/braid.git",
    "directory": "integrations/pi"
  },
  "homepage": "https://github.com/Epsirom/braid/tree/main/integrations/pi#readme",
  "bugs": {
    "url": "https://github.com/Epsirom/braid/issues"
  },
  "keywords": [
    "pi-package",
    "llm",
    "agents",
    "dag"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js"
  }
}
